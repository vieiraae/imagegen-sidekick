# Non-secret defaults for walkthrough recordings. Override in .env.local, env or CLI flags.
WT_WIDTH=1280
WT_HEIGHT=720
WT_FPS=30
WT_CRF=20
WT_CAPTIONS=true
WT_CAPTION_SIZE=34
WT_CAPTION_COLOR=#FFFFFF
WT_CAPTION_HIGHLIGHT=#FFD400
WT_ACCENT=#FFD400
WT_CURSOR_MS=600
WT_TAIL_MS=1200
WT_ACTION_TIMEOUT=15000
WT_FFMPEG=ffmpeg
