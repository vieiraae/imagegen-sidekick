# Non-secret defaults. Authentication uses the current Azure CLI identity.
FOUNDRY_PROJECT_ENDPOINT=https://foundry-imagegen.services.ai.azure.com/api/projects/proj-imagegen
# Optional: Speech endpoint override; derived from the project endpoint when empty.
SPEECH_ENDPOINT=
TTS_VOICE=Harper
TTS_MODEL=MAI-Voice-2
TTS_LANGUAGE=en-US
# Prosody multipliers: 1 = voice default, 1.1 = 10% higher/faster/louder.
TTS_PITCH=1
TTS_RATE=1.1
TTS_VOLUME=1
# Optional mstts:express-as style, e.g. happiness, excitement, empathy.
TTS_STYLE=
# wav (24 kHz 16-bit mono PCM), mp3 or ogg (Opus).
TTS_AUDIO_FORMAT=wav
# Use speech recognition to build the word timeline when the voice emits no word boundaries (WAV only).
TTS_ALIGN_WITH_RECOGNITION=true
TTS_TIMEOUT=300
