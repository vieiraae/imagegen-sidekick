# Non-secret defaults. Authentication uses the current Azure CLI identity.
AZURE_OPENAI_ENDPOINT=https://foundry-imagegen.openai.azure.com/openai/v1
AZURE_OPENAI_SCOPE=https://ai.azure.com/.default
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=auto
IMAGE_BACKGROUND=transparent
IMAGE_FORMAT=png
IMAGE_MODERATION=low
IMAGE_TIMEOUT=180
IMAGE_MAX_RETRIES=0
